{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@ingenui/incremental-jsx-parser/react": [
        "../../packages/incremental-jsx-parser/src/react.ts"
      ],
      "@ingenui/incremental-jsx-parser/core": ["../../packages/incremental-jsx-parser/src/core.ts"],
      "@ingenui/incremental-jsx-parser": ["../../packages/incremental-jsx-parser/src/index.ts"],
      "ingenui/react": ["../../packages/ingenui/src/react.ts"],
      "ingenui/schema": ["../../packages/ingenui/src/schema.ts"],
      "ingenui/server": ["../../packages/ingenui/src/server.ts"],
      "ingenui": ["../../packages/ingenui/src/index.ts"]
    }
  },
  "include": ["src", "worker", "vite.config.ts"]
}
