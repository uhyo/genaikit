{
  "name": "generative-ui-toolchain",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for a Generative UI toolchain: stream LLM-generated JSX into live React trees.",
  "license": "MIT",
  "author": "uhyo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uhyo/ingenui.git"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm -r --parallel run dev",
    "typecheck": "pnpm -r run typecheck",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "pnpm -r run test",
    "test:coverage": "pnpm -r run test:coverage",
    "check": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run test",
    "publint": "pnpm -r run publint",
    "attw": "pnpm -r run attw",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "oxfmt": "0.55.0",
    "oxlint": "1.70.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0"
}
