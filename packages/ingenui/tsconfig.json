{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    // Typecheck/test resolve the workspace dependency straight to its source,
    // so no build step is needed first (same pattern as apps/demo). The tsdown
    // build ignores these paths and keeps the dependency external.
    "paths": {
      "@ingenui/incremental-jsx-parser/react": ["../incremental-jsx-parser/src/react.ts"],
      "@ingenui/incremental-jsx-parser/core": ["../incremental-jsx-parser/src/core.ts"],
      "@ingenui/incremental-jsx-parser": ["../incremental-jsx-parser/src/index.ts"]
    }
  },
  "include": ["src", "tsdown.config.ts", "vitest.config.ts"]
}
